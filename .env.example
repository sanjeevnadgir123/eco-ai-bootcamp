# ==============================================================================
# ECO AI BOOTCAMP — ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' for local development. Never commit real credentials!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. BACKEND SECRETS (Google Cloud Run / Local Server Only)
# NOTE: Secrets must NEVER be prefixed with VITE_ or exposed to client browsers.
# ------------------------------------------------------------------------------

# Neon Serverless PostgreSQL Connection String
# Obtain from Neon Console: https://console.neon.tech -> Connection Details
DATABASE_URL=postgresql://neondb_owner:your_neon_password@ep-your-endpoint-id.region.aws.neon.tech/neondb?sslmode=require

# Gmail SMTP Configuration for OTP & Notification Emails
# Requires a 16-character Google App Password (https://myaccount.google.com/apppasswords)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your_official_email@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx
SMTP_FROM="Geminal Studio <your_official_email@gmail.com>"

# Secret Salt for HMAC-SHA256 OTP Code Hashing (protects OTPs at rest in DB)
OTP_SECRET=your-random-cryptographic-salt-change-in-production

# Allowed Frontend Origins for CORS Restriction (comma-separated if multiple)
# In production on Cloud Run, set this to your Vercel frontend domain:
FRONTEND_URL=https://your-bootcamp-app.vercel.app,http://localhost:5173

# Server Listen Port (Defaults to 8080 on Cloud Run, 5173 for local dev)
PORT=8080
HOST=0.0.0.0

# ------------------------------------------------------------------------------
# 2. FRONTEND CONFIGURATION (Vercel / Browser)
# Only non-secret public values belong here.
# ------------------------------------------------------------------------------

# Google Cloud Run Backend API Base URL
# Leave empty for same-domain proxy or local Vite development.
# Set on Vercel to your deployed Google Cloud Run URL: https://eco-backend-xxxx.a.run.app
VITE_API_BASE_URL=

# Administrative Portal Access (Optional override for dashboard authentication)
VITE_ADMIN_PASSWORD=EcoAdmin2026!
